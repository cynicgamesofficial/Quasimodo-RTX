# --- Project-specific vendored dependency rules ---
# These folders must be committed completely, even if their files match global ignore patterns above.
!Third Parties/
!Third Parties/freetype/
!Third Parties/freetype/**
!Third Parties/lunasvg/
!Third Parties/lunasvg/**
!Third Parties/RmlUi/
!Third Parties/RmlUi/**

# Keep the whole UI folder tracked as-is.
!baseq2/ui/
!baseq2/ui/**

# These third-party folders must stay fully ignored.
Third Parties/NRD/
Third Parties/NRD/**
Third Parties/NVIDIA/
Third Parties/NVIDIA/**
Third Parties/DLSS/
Third Parties/DLSS/**

# Ignore the entire Streamline SDK folder.
streamline/
streamline/**
streamline/bin/x64/*.dll
streamline/bin/x64/backup*/
sl.common.json
sl.imgui.json
sl.reflex.json

# Runtime/script test artifacts.
e3a_validation_*
rr_*_test_*
rr_extended_render_*
dlss_sr_dll_swap_*
dlss_script_setup_*
*.err

# Ignore RTXDI third-party folder.
Third Parties/RTXDI/
Third Parties/RTXDI/**

# Local Cursor / editor workspace files may contain machine-specific paths
*.code-workspace
