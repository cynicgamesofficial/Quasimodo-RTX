.menu-root {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 6, 10, 0.98);
}

.pause-root {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 6, 10, 0.86);
}

.menu-shell,
.pause-panel {
    position: relative;
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.20);
    background-color: rgba(8, 12, 18, 0.99);
    max-height: 92%;
    overflow-y: auto;
}

.menu-shell {
    width: 900px;
    padding: 50px 64px 58px;
}

.pause-panel {
    width: 640px;
    padding: 44px 54px 52px;
}

.brand {
    margin-bottom: 6px;
    color: #ffffff;
    font-family: Rajdhani;
    font-size: 72px;
    font-weight: bold;
    letter-spacing: 0.12em;
    text-align: center;
}

.brand.small {
    font-size: 50px;
}

.subtitle {
    margin-bottom: 28px;
    color: rgba(74, 222, 128, 0.88);
    font-family: Rajdhani;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 0.30em;
    text-align: center;
}

.menu-rule {
    height: 1px;
    background-color: rgba(74, 222, 128, 0.16);
    margin-bottom: 22px;
}

.menu-group-label {
    padding: 12px 22px 4px;
    color: rgba(74, 222, 128, 0.60);
    font-family: Rajdhani;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.24em;
    text-transform: uppercase;
}

.menu-separator {
    height: 1px;
    background-color: rgba(74, 222, 128, 0.10);
    margin-top: 10px;
    margin-bottom: 10px;
}
