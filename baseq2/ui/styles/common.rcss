* {
    box-sizing: border-box;
    font-family: Rajdhani;
    color: rgba(255, 255, 255, 0.95);
}

body {
    width: 100%;
    height: 100%;
    margin: 0px;
}

.hidden {
    display: none;
}

button {
    display: block;
    width: 100%;
    min-height: 68px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 16px 22px 16px 26px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 4px;
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(255, 255, 255, 0.10);
    border-left-color: rgba(255, 255, 255, 0.24);
    background-color: rgba(255, 255, 255, 0.07);
    color: #f0f0f0;
    opacity: 1;
    font-family: Rajdhani;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 0.04em;
    text-align: left;
}

button:hover {
    border-bottom-color: rgba(74, 222, 128, 0.30);
    border-left-color: rgba(74, 222, 128, 0.95);
    background-color: rgba(74, 222, 128, 0.13);
    color: #ffffff;
}

button:focus {
    border-bottom-color: rgba(74, 222, 128, 0.24);
    border-left-color: rgba(74, 222, 128, 0.80);
    background-color: rgba(74, 222, 128, 0.10);
    color: #ffffff;
}

button:active {
    border-bottom-color: rgba(74, 222, 128, 0.42);
    border-left-color: rgba(74, 222, 128, 1.0);
    background-color: rgba(74, 222, 128, 0.22);
    color: #ffffff;
}

button.btn-danger {
    color: rgba(255, 228, 228, 1.0);
    border-left-color: rgba(248, 113, 113, 0.75);
    border-bottom-color: rgba(248, 113, 113, 0.38);
    background-color: rgba(248, 80, 80, 0.20);
}

button.btn-danger:hover {
    border-bottom-color: rgba(255, 130, 130, 0.55);
    border-left-color: rgba(255, 130, 130, 0.98);
    background-color: rgba(248, 80, 80, 0.30);
    color: #ffffff;
}

button.btn-danger:focus {
    border-bottom-color: rgba(255, 130, 130, 0.50);
    border-left-color: rgba(255, 130, 130, 0.95);
    background-color: rgba(248, 80, 80, 0.26);
    color: #ffffff;
}

button.btn-danger:active {
    border-bottom-color: rgba(255, 130, 130, 0.62);
    border-left-color: rgba(255, 130, 130, 1.0);
    background-color: rgba(248, 80, 80, 0.36);
    color: #ffffff;
}

button:disabled {
    color: rgba(255, 255, 255, 0.65);
    border-left-color: rgba(255, 255, 255, 0.20);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.06);
}
