/* Classical settings menu: root submenu tree plus one readable page at a time. */

#settings-root {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

#settings-shell {
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.34);
    background-color: rgba(7, 10, 14, 0.99);
    color: #f7fbff;
}

/* Main settings category tree only — subsection lists match editor panel sizing (Graphics Display reference). */
#settings-shell.settings-shell--home {
    width: 900px;
    max-width: 92%;
    height: auto;
    max-height: 92%;
    padding: 50px 64px 44px;
}

/* Cap viewport height so long tabs (Player, Path Tracer) scroll inside #settings-content like Graphics Display. */
#settings-shell.settings-shell--section,
#settings-shell.settings-shell--controls,
#settings-shell.settings-shell--panel {
    width: 1120px;
    max-width: 92%;
    max-height: 92vh;
    padding: 44px 56px 40px;
    overflow: hidden;
}

#settings-status-row {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.14);
}

#settings-shell.settings-shell--home #settings-status-row {
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    padding-bottom: 18px;
}

#settings-title-block {
    display: flex;
    flex-direction: column;
}

#settings-title {
    font-size: 44px;
    line-height: 50px;
    font-weight: bold;
    letter-spacing: 0px;
    color: #ffffff;
}

#settings-shell.settings-shell--home #settings-title {
    font-size: 58px;
    line-height: 64px;
    text-align: center;
}

#settings-caption {
    margin-top: 6px;
    font-size: 17px;
    color: rgba(107, 255, 158, 0.92);
    letter-spacing: 0px;
    text-transform: uppercase;
}

#settings-shell.settings-shell--home #settings-caption {
    text-align: center;
}

#settings-dirty {
    display: none;
    padding: 10px 16px;
    border-width: 1px;
    border-color: rgba(250, 204, 21, 0.70);
    background-color: rgba(250, 204, 21, 0.20);
    color: rgba(255, 248, 204, 1);
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 0px;
    text-transform: uppercase;
}

#settings-shell.settings-shell--home #settings-dirty,
#settings-shell.settings-shell--section #settings-dirty {
    display: none;
}

#settings-body {
    flex: 1;
    min-height: 0px;
    display: flex;
    flex-direction: column;
}

#settings-shell.settings-shell--home #settings-body {
    flex: 0 0 auto;
    min-height: 0px;
}

#settings-shell.settings-shell--section #settings-body,
#settings-shell.settings-shell--controls #settings-body,
#settings-shell.settings-shell--panel #settings-body {
    flex: 1 1 auto;
    min-height: 0px;
    overflow: hidden;
}

#settings-home {
    flex: 1;
    min-height: 0px;
    display: flex;
    flex-direction: column;
}

#settings-shell.settings-shell--home #settings-home {
    flex: 0 0 auto;
    min-height: 0px;
}

#settings-shell.settings-shell--section #settings-panel,
#settings-shell.settings-shell--controls #settings-panel,
#settings-shell.settings-shell--panel #settings-panel {
    flex: 1 1 auto;
    min-height: 0px;
    overflow: hidden;
}

#settings-home-title {
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0px;
}

#settings-home-subtitle {
    margin-top: 6px;
    margin-bottom: 20px;
    font-size: 18px;
    color: rgba(220, 230, 240, 0.76);
}

#settings-tree {
    flex: 0 0 auto;
    overflow: visible;
    padding-right: 0px;
}

button.tree-item {
    display: block;
    width: 100%;
    min-height: 56px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 13px 22px 13px 26px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 5px;
    border-bottom-color: rgba(255, 255, 255, 0.13);
    border-left-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.055);
    color: #f0f0f0;
    font-size: 25px;
    font-weight: bold;
    letter-spacing: 0.04em;
    text-align: left;
}

button.tree-item:hover,
button.tree-item:focus {
    border-bottom-color: rgba(74, 222, 128, 0.62);
    border-left-color: rgba(74, 222, 128, 1);
    background-color: rgba(74, 222, 128, 0.14);
}

button.tree-item:active {
    background-color: rgba(74, 222, 128, 0.24);
}

#settings-panel {
    flex: 1;
    min-width: 0px;
    min-height: 0px;
    display: flex;
    flex-direction: column;
}

#settings-breadcrumb {
    flex-shrink: 0;
    flex: 0 0 auto;
    min-height: 30px;
    padding: 0px 4px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
    color: rgba(107, 255, 158, 0.94);
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
}

#settings-content {
    flex: 0 1 auto;
    min-height: 0px;
    max-height: 650px;
    overflow-y: auto;
    padding-top: 8px;
    padding-right: 4px;
}

/* Fill panel below breadcrumb; scroll here — same behavior for Display, Player, Path Tracer, etc. */
#settings-shell.settings-shell--section #settings-content,
#settings-shell.settings-shell--controls #settings-content,
#settings-shell.settings-shell--panel #settings-content {
    flex: 1 1 auto;
    min-height: 0px;
    max-height: none;
    overflow-y: auto;
}

.settings-section {
    margin-top: 14px;
    margin-bottom: 4px;
    padding: 10px 22px 4px;
    border-bottom-width: 0px;
    color: rgba(74, 222, 128, 0.72);
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.settings-section:first-child {
    margin-top: 0px;
}

.settings-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 64px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 8px 14px 8px 22px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 5px;
    border-bottom-color: rgba(255, 255, 255, 0.11);
    border-left-color: rgba(255, 255, 255, 0.10);
    background-color: rgba(255, 255, 255, 0.040);
}

.settings-row:hover {
    border-left-color: rgba(74, 222, 128, 0.78);
    background-color: rgba(255, 255, 255, 0.07);
}

.settings-row.focused {
    border-left-color: rgba(74, 222, 128, 0.98);
    background-color: rgba(74, 222, 128, 0.10);
}

.settings-row.active {
    border-left-color: rgba(74, 222, 128, 1);
    background-color: rgba(74, 222, 128, 0.16);
}

.settings-row--unavailable {
    border-left-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.025);
}

.row-main {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: 100%;
    min-width: 0px;
}

.setting-info {
    flex: 1;
    width: auto;
    min-width: 0px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: 22px;
}

.row-label {
    font-size: 22px;
    line-height: 26px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0px;
}

.row-description {
    margin-top: 3px;
    font-size: 14px;
    line-height: 17px;
    color: rgba(220, 230, 240, 0.80);
    letter-spacing: 0px;
}

.control-kind,
.restart-badge {
    width: auto;
    margin-top: 5px;
    padding: 3px 8px;
    border-width: 1px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0px;
    text-transform: uppercase;
}

.control-kind {
    display: none;
    border-color: rgba(107, 255, 158, 0.42);
    background-color: rgba(74, 222, 128, 0.12);
    color: rgba(218, 255, 230, 1);
}

.restart-badge {
    border-color: rgba(250, 204, 21, 0.70);
    background-color: rgba(250, 204, 21, 0.20);
    color: rgba(255, 248, 204, 1);
}

.settings-row--unavailable .control-kind {
    display: block;
    border-color: rgba(250, 204, 21, 0.58);
    background-color: rgba(250, 204, 21, 0.14);
    color: rgba(255, 248, 204, 1);
}

.row-control {
    flex: 0 0 auto;
    flex-shrink: 0;
    width: 440px;
    min-width: 440px;
    max-width: 440px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 0px;
}

.row-value {
    flex: 0 0 auto;
    width: 100%;
    min-height: 24px;
    margin-left: 0px;
    margin-top: 5px;
    display: none;
    align-items: center;
    justify-content: flex-start;
    padding: 0px 0px 0px 0px;
    border-width: 0px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 14px;
    font-weight: bold;
    text-align: left;
    color: rgba(180, 194, 204, 0.86);
    letter-spacing: 0px;
}

.setting-row--slider .row-value,
.settings-row--unavailable .row-value {
    display: flex;
}

.row-value.value--on {
    color: rgba(107, 255, 158, 1);
}

.row-value.value--off {
    color: rgba(226, 184, 184, 0.95);
}

.switch-control {
    width: 132px;
    min-width: 132px;
    height: 42px;
    display: flex;
    flex-direction: row;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.07);
}

.switch-option {
    flex: 1;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 19px;
    font-weight: bold;
    text-align: center;
    color: rgba(220, 230, 240, 0.72);
    background-color: rgba(0, 0, 0, 0.18);
}

.switch-option--off {
    border-right-width: 0px;
}

.switch--off .switch-option--off {
    display: flex;
    color: #ffffff;
    background-color: rgba(248, 113, 113, 0.34);
}

.switch--on .switch-option--on {
    display: flex;
    color: #06120a;
    background-color: rgba(74, 222, 128, 0.94);
}

.settings-row:hover .switch-control,
.settings-row.focused .switch-control {
    border-color: rgba(74, 222, 128, 0.90);
}

button.step-btn,
button.choice-btn {
    margin-top: 0px;
    margin-bottom: 0px;
    padding: 0px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 0px;
    border-bottom-color: rgba(255, 255, 255, 0.24);
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-weight: bold;
    text-align: center;
}

button.step-btn {
    width: 44px;
    min-width: 44px;
    min-height: 44px;
    font-size: 26px;
}

button.choice-btn {
    width: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0px 8px;
    font-size: 22px;
    text-transform: uppercase;
}

button.step-btn:hover,
button.step-btn:focus,
button.choice-btn:hover,
button.choice-btn:focus {
    border-bottom-color: rgba(74, 222, 128, 0.90);
    background-color: rgba(74, 222, 128, 0.22);
}

button.step-btn:active,
button.choice-btn:active {
    background-color: rgba(74, 222, 128, 0.34);
}

.slider-wrap {
    flex: 1;
    min-width: 220px;
    height: 52px;
    position: relative;
    margin-left: 12px;
    margin-right: 12px;
    display: flex;
    align-items: center;
}

.slider-track {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 68%;
    margin-top: -5px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.20);
    pointer-events: none;
}

.slider-fill {
    position: absolute;
    left: 0px;
    top: 68%;
    margin-top: -5px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(74, 222, 128, 0.98);
    width: 50%;
    pointer-events: none;
}

.slider-thumb {
    position: absolute;
    left: 50%;
    top: 68%;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    margin-top: -14px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(74, 222, 128, 1);
    background-color: #ffffff;
    pointer-events: none;
}

.slider-wrap:hover .slider-track,
.slider-wrap.dragging .slider-track {
    background-color: rgba(255, 255, 255, 0.30);
}

.slider-wrap:hover .slider-thumb,
.slider-wrap.dragging .slider-thumb {
    border-width: 3px;
    border-color: rgba(107, 255, 158, 1);
}

.slider-readout {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 21px;
    font-weight: bold;
    text-align: center;
    pointer-events: none;
}

.select-box,
.text-box,
.keybind-pill {
    flex: 1;
    width: auto;
    min-width: 0px;
    min-height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0px 16px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 5px;
    border-bottom-color: rgba(255, 255, 255, 0.26);
    border-left-color: rgba(74, 222, 128, 0.54);
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

.switch-control,
.select-box,
.text-box,
.keybind-pill,
.slider-wrap {
    max-width: 440px;
}

.select-label,
.text-label,
.keybind-label {
    flex: 1;
    min-width: 0px;
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
}

/* Live text edit + dropdown value must stay readable while typing / scrolling */
.text-label {
    white-space: pre;
    overflow: visible;
    min-height: 22px;
}

.setting-row--choice .select-box {
    min-width: 180px;
}

.select-hint,
.text-hint,
.keybind-hint {
    flex: 0 0 auto;
    margin-left: 10px;
    color: rgba(220, 230, 240, 0.68);
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
}

.settings-row:hover .select-box,
.settings-row:hover .text-box,
.settings-row:hover .keybind-pill,
.settings-row.focused .select-box,
.settings-row.focused .text-box,
.settings-row.focused .keybind-pill {
    border-bottom-color: rgba(74, 222, 128, 0.92);
    background-color: rgba(74, 222, 128, 0.13);
}

.keybind-pill.waiting,
.text-box.waiting {
    border-left-color: rgba(250, 204, 21, 1);
    border-bottom-color: rgba(250, 204, 21, 0.98);
    background-color: rgba(250, 204, 21, 0.20);
}

.text-box.waiting .text-label,
.keybind-pill.waiting .keybind-label {
    color: #ffffff;
}

.settings-row--unavailable .select-box,
.settings-row--unavailable .text-box,
.settings-row--unavailable .keybind-pill,
.settings-row--unavailable .switch-control,
.settings-row--unavailable .slider-wrap {
    opacity: 0.62;
}

.row-control button {
    width: auto;
}

.row-control button.step-btn {
    width: 44px;
    min-width: 44px;
}

.row-control button.choice-btn {
    width: 44px;
    min-width: 44px;
}

#settings-footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    padding-top: 18px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.14);
}

#settings-footer button {
    width: auto;
    min-width: 190px;
    min-height: 64px;
    margin-top: 0px;
    margin-bottom: 0px;
    padding: 14px 34px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 0px;
    border-bottom-color: rgba(255, 255, 255, 0.26);
    background-color: rgba(255, 255, 255, 0.06);
    color: #f6f9fc;
    font-family: Rajdhani;
    font-size: 23px;
    font-weight: bold;
    letter-spacing: 0px;
    text-transform: uppercase;
    text-align: center;
}

#settings-footer button:hover,
#settings-footer button:focus {
    border-bottom-color: rgba(74, 222, 128, 1);
    background-color: rgba(74, 222, 128, 0.18);
}

#settings-footer button:active {
    background-color: rgba(74, 222, 128, 0.30);
}

#btn-reset {
    border-bottom-color: rgba(248, 113, 113, 0.68);
    background-color: rgba(248, 113, 113, 0.12);
    color: rgba(255, 230, 230, 1);
}

#btn-reset:hover,
#btn-reset:focus {
    border-bottom-color: rgba(248, 113, 113, 1);
    background-color: rgba(248, 113, 113, 0.24);
}

#btn-back {
    margin-left: 14px;
    border-bottom-color: rgba(74, 222, 128, 0.75);
    background-color: rgba(74, 222, 128, 0.12);
    color: #f6fff0;
}

#btn-back:hover,
#btn-back:focus {
    border-bottom-color: rgba(74, 222, 128, 1);
    background-color: rgba(74, 222, 128, 0.26);
}

.footer-spacer {
    flex: 1;
}

#settings-confirm {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    display: none;
    background-color: rgba(0, 0, 0, 0.82);
}

#confirm-box {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    padding: 34px 38px;
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.50);
    background-color: rgba(10, 14, 20, 1);
    transform: translate(-50%, -50%);
}

#confirm-title {
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 0px;
    color: #ffffff;
}

#confirm-text {
    margin-top: 12px;
    font-size: 20px;
    color: rgba(230, 238, 246, 0.92);
}

#confirm-actions {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 28px;
}

#confirm-actions button {
    width: auto;
    min-width: 150px;
    min-height: 54px;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 12px;
    padding: 12px 26px;
    border-top-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 1px;
    border-left-width: 0px;
    border-bottom-color: rgba(255, 255, 255, 0.32);
    background-color: rgba(255, 255, 255, 0.08);
    color: #f6f9fc;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0px;
    text-transform: uppercase;
    text-align: center;
}

#confirm-actions button:hover {
    border-bottom-color: rgba(74, 222, 128, 1);
    background-color: rgba(74, 222, 128, 0.22);
}
