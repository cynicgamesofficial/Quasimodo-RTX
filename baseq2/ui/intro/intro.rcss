body {
    width: 100%;
    height: 100%;
    margin: 0px;
    background-color: #000000;
    font-family: Rajdhani;
    color: #ffffff;
}

#intro {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    height: 100%;
    background-color: #000000;
    overflow: hidden;
}

#bg-layer {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.97);
}

.particle {
    position: absolute;
    background-color: rgba(180, 200, 255, 0.2);
}

#scanlines {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.scanline {
    position: absolute;
    left: 0px;
    width: 100%;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.08);
}

.stage {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

#stage-cynic {
    justify-content: center;
    padding-top: 0px;
}

.logo {
    position: relative;
}

.logo.engine {
    display: block;
    position: absolute;
    left: 38px;
    top: 38px;
    width: 196px;
    height: 196px;
    transform-origin: 50% 50%;
}

#cynic-text {
    overflow: hidden;
    height: 0px;
    margin-top: 150px;
}

#cynic-label {
    font-family: "Roboto Mono";
    font-size: 24px;
    line-height: 32px;
    font-weight: normal;
    color: #ffffff;
    letter-spacing: 0px;
    text-align: center;
    opacity: 0;
}

#cynic-sub {
    font-family: "Roboto Mono";
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0px;
    margin-top: 8px;
    color: rgba(255, 255, 255, 0);
}

#engine-lockup {
    position: relative;
    width: 780px;
    max-width: 88%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#engine-transversal-line {
    position: absolute;
    left: 60px;
    top: 224px;
    width: 0px;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.94);
    transform: rotate(-13deg);
    transform-origin: 0px 50%;
}

#engine-logo-wrap {
    position: relative;
    width: 272px;
    height: 272px;
    margin-bottom: 28px;
    overflow: hidden;
}

#engine-logo-halo {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 224px;
    height: 224px;
    border-width: 1px;
    border-color: rgba(255, 0, 153, 0.36);
    border-radius: 112px;
    background-color: rgba(255, 0, 153, 0.08);
    transform-origin: 50% 50%;
}

#engine-logo {
    opacity: 0;
}

.logo.engine.echo {
    opacity: 0;
}

#engine-logo-sheen {
    position: absolute;
    top: 28px;
    width: 26px;
    height: 216px;
    background-color: rgba(255, 255, 255, 0.50);
    transform: rotate(18deg);
}

#engine-title-wrap {
    position: relative;
    width: 100%;
    height: 112px;
    overflow: hidden;
}

#engine-title {
    position: absolute;
    top: 2px;
    left: 0px;
    width: 100%;
    height: 102px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    font-family: Rajdhani;
    font-size: 62px;
    line-height: 98px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0px;
    text-align: center;
    white-space: nowrap;
}

#engine-title-main {
    display: block;
    font-family: Rajdhani;
    font-size: 62px;
    line-height: 98px;
    font-weight: bold;
    text-align: center;
}

#engine-title-gap {
    width: 34px;
    height: 1px;
}

#engine-title-rtx {
    display: block;
    font-family: Rajdhani;
    font-size: 62px;
    line-height: 98px;
    font-weight: bold;
    text-align: center;
}

#engine-mask {
    position: absolute;
    top: 0px;
    right: 0px;
    height: 112px;
    width: 100%;
    background-color: #000000;
}

#engine-sub {
    font-size: 15px;
    line-height: 20px;
    letter-spacing: 0px;
    margin-top: 4px;
    color: rgba(255, 255, 255, 0);
}

#engine-ver {
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0px;
    margin-top: 8px;
    color: rgba(255, 255, 255, 0);
}

#press-key {
    font-size: 18px;
    letter-spacing: 0px;
    color: rgba(255, 255, 255, 0.3);
}
