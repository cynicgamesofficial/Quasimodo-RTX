body {
    width: 100%;
    height: 100%;
    margin: 0px;
    pointer-events: none;
}

.hidden {
    display: none;
}

#ch-root {
    position: absolute;
    top: 0px;
    left: 0px;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    z-index: 32000;
}

#ch-debug-center {
    display: none;
    position: absolute;
    box-sizing: border-box;
    width: 7px;
    height: 7px;
    background-color: rgba(255, 0, 255, 0.90);
}

#ch-debug-label {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-left: 12px;
    margin-top: 12px;
    color: rgba(255, 0, 255, 0.95);
    font-size: 12px;
    font-family: "Roboto Mono";
}

.debug-bounds #ch-debug-center,
.debug-bounds #ch-debug-label {
    display: block;
}

.ch-line {
    position: absolute;
    box-sizing: border-box;
    background-color: #ffffff;
}

.ch-dot {
    position: absolute;
    box-sizing: border-box;
    background-color: #ffffff;
}

.ch-circle {
    position: absolute;
    box-sizing: border-box;
    background-color: transparent;
    border-color: #ffffff;
    border-width: 1px;
}

.ch-outline,
.ch-outline-dot {
    position: absolute;
    box-sizing: border-box;
    background-color: rgba(0, 0, 0, 0.75);
}

.ch-outline-circle {
    position: absolute;
    box-sizing: border-box;
    background-color: transparent;
    border-color: rgba(0, 0, 0, 0.75);
    border-width: 1px;
}
