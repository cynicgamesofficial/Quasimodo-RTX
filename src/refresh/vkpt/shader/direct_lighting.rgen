// ========================================================================== //
// This rgen shader computes direct lighting for the first opaque surface. 
// The parameters of that surface are loaded from the G-buffer, stored there
// previously by the `primary_rays.rgen` and `reflect_refract.rgen` shaders.
//
// See `path_tracer.h` for an overview of the path tracer.
// ========================================================================== //

#version 460
#extension GL_GOOGLE_include_directive    : enable
#pragma optionNV(unroll all)

#define ENABLE_SHADOW_CAUSTICS
#include "path_tracer_rgen.h"
#include "projection.glsl"
#include "restir_di.glsl"

layout(constant_id = 0) const uint spec_enable_caustics = 0;

#define RESTIR_DI_DEBUG_MODE_WEIGHT 1
#define RESTIR_DI_DEBUG_MODE_M 2
#define RESTIR_DI_DEBUG_MODE_LIGHT_TYPE 3
#define RESTIR_DI_DEBUG_MODE_TARGET_PDF 4
#define RESTIR_DI_DEBUG_MODE_TEMPORAL_VS_SPATIAL 5
#define RESTIR_DI_DEBUG_MODE_TEMPORAL_LIFECYCLE 6

/*
 * Observational debug only: maps packed reservoir fields to linear RGB for HF output.
 * Does not alter reservoir packing, RIS, temporal pass, or shading estimators.
 * Sunlight is omitted when active so the view is local-light / reservoir only.
 */
vec3
restir_di_debug_visualize(Reservoir res, int mode)
{
	/* Mode 1: W — typical final weights often fall in single digits..low tens; clamp highlights. */
	const float RESTIR_DEBUG_W_SCALE = 50.0;

	if(mode == RESTIR_DI_DEBUG_MODE_WEIGHT)
	{
		if(res.M == 0u || res.W <= 0.0)
			return vec3(0.0);
		float g = clamp(res.W / RESTIR_DEBUG_W_SCALE, 0.0, 1.0);
		return vec3(g);
	}
	if(mode == RESTIR_DI_DEBUG_MODE_M)
	{
		if(res.M == 0u)
			return vec3(0.0);
		float g = clamp(float(res.M) / float(RESTIR_M_CAP), 0.0, 1.0);
		return vec3(g);
	}
	if(mode == RESTIR_DI_DEBUG_MODE_LIGHT_TYPE)
	{
		if(res.M == 0u)
			return vec3(0.0);
		if(restir_is_sun_light(res.lightData))
			return vec3(0.15, 1.0, 0.15); /* sun = green */
		if(restir_is_dynamic_light(res.lightData))
			return vec3(1.0, 0.15, 0.15); /* dynamic = red */
		return vec3(0.15, 0.35, 1.0);   /* polygon = blue */
	}
	if(mode == RESTIR_DI_DEBUG_MODE_TARGET_PDF)
	{
		if(res.M == 0u || res.targetPdf <= 0.0)
			return vec3(0.0);
		/* log2 map; avoids NaN by clamping the argument */
		const float TPDF_LOG_MIN = -20.0;
		const float TPDF_LOG_MAX = 10.0;
		float x = log2(max(res.targetPdf, 1e-20));
		float g = clamp((x - TPDF_LOG_MIN) / (TPDF_LOG_MAX - TPDF_LOG_MIN), 0.0, 1.0);
		return vec3(g);
	}
	if(mode == RESTIR_DI_DEBUG_MODE_TEMPORAL_VS_SPATIAL)
	{
		if(res.M == 0u)
			return vec3(0.0);
		/* M <= RESTIR_M_CAP (20): temporal only → blue.
		 * M >  RESTIR_M_CAP:     spatial neighbors accepted → green. */
		const uint M_TEMPORAL_MAX = uint(RESTIR_M_CAP);
		const uint M_SPATIAL_MAX  = 30u;
		if(res.M <= M_TEMPORAL_MAX)
		{
			float t = float(res.M) / float(M_TEMPORAL_MAX);
			return vec3(0.0, 0.0, t);
		}
		float t = float(res.M - M_TEMPORAL_MAX) / float(M_SPATIAL_MAX - M_TEMPORAL_MAX);
		return vec3(0.0, clamp(t, 0.0, 1.0), 0.0);
	}
	if(mode == RESTIR_DI_DEBUG_MODE_TEMPORAL_LIFECYCLE)
	{
		if(global_ubo.restir_reset_reason_bits != 0)
			return vec3(1.0, 0.0, 0.0);

		float history_valid = (global_ubo.restir_history_valid != 0) ? 1.0 : 0.0;
		float generation_match = (global_ubo.restir_history_generation == global_ubo.restir_current_generation) ? 1.0 : 0.0;
		float temporal_bypass = (global_ubo.restir_temporal_bypass != 0) ? 1.0 : 0.0;
		return vec3(history_valid, generation_match, temporal_bypass);
	}
	return vec3(0.0);
}

void
direct_lighting(ivec2 ipos, bool is_odd_checkerboard, out vec3 high_freq, out vec3 o_specular)
{
	high_freq = vec3(0);
	o_specular = vec3(0);

	rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;


	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);
	
	vec3 position   = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);

	// don't compute lighting for invalid surfaces
	if(material_id == 0)
		return;

	vec4 view_direction = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0);
	vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
    vec3 geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
    vec4 primary_base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
    float primary_specular_factor = primary_base_color.a;
    vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
    float primary_metallic = metal_rough.x;
	float primary_roughness = metal_rough.y;
	uint cluster_idx = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;
	if(cluster_idx == 0xffff) cluster_idx = ~0u; // because the image is uint16

	bool primary_is_weapon = (material_id & MATERIAL_FLAG_WEAPON) != 0;
	int primary_medium = int((material_id & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT);

	int shadow_cull_mask = SHADOW_RAY_CULL_MASK;

	if(global_ubo.first_person_model != 0 && !primary_is_weapon)
		shadow_cull_mask |= AS_FLAG_VIEWER_MODELS;
	else
		shadow_cull_mask |= AS_FLAG_VIEWER_WEAPON;

	float direct_specular_weight = smoothstep(
		global_ubo.pt_direct_roughness_threshold - 0.02, 
		global_ubo.pt_direct_roughness_threshold + 0.02, 
		primary_roughness);

	bool is_gradient = get_is_gradient(ipos);

    vec3 primary_albedo, primary_base_reflectivity;
    get_reflectivity(primary_base_color.rgb, primary_metallic, primary_albedo, primary_base_reflectivity);

	vec3 direct_diffuse, direct_specular;
	bool suppress_sun_for_restir_debug = false;

	if(global_ubo.pt_restir_di != 0)
	{
		// ---- ReSTIR DI path: shade the reservoir's selected light ---- //
		direct_diffuse  = vec3(0);
		direct_specular = vec3(0);

		Reservoir res;
		vec3 pos_on_light;

		if(global_ubo.pt_restir_di_spatial != 0)
		{
			res = reservoir_unpack(imageLoad(IMG_RESTIR_RESERVOIR_B, ipos));
			pos_on_light = imageLoad(IMG_RESTIR_SAMPLE_POS_B, ipos).xyz;
		}
		else
		{
			res = reservoir_unpack(imageLoad(IMG_RESTIR_RESERVOIR_A, ipos));
			pos_on_light = imageLoad(IMG_RESTIR_SAMPLE_POS_A, ipos).xyz;
		}

		int restir_dbg = int(global_ubo.pt_restir_di_debug);

		if(restir_dbg != 0)
		{
			suppress_sun_for_restir_debug = true;
			direct_diffuse = restir_di_debug_visualize(res, restir_dbg);
		}
		else if(res.M > 0 && res.W > 0.0)
		{
			vec3  light_color  = vec3(0);
			bool  valid_sample = false;

			if(restir_is_sun_light(res.lightData))
			{
				if(global_ubo.sun_visible != 0)
				{
					vec3 L = normalize(pos_on_light - position);
					float NdotL  = dot(L, normal);
					float GNdotL = dot(L, geo_normal);

					if(NdotL > 0.0 && GNdotL > 0.0)
					{
						light_color  = sun_color_ubo.sun_color;
						valid_sample = true;
					}
				}
			}
			else if(restir_is_dynamic_light(res.lightData))
			{
				uint dyn_idx = restir_get_light_index(res.lightData);

				if(dyn_idx < global_ubo.num_dyn_lights)
				{
					vec3 light_center = global_ubo.dyn_light_data[dyn_idx].center;
					light_color       = global_ubo.dyn_light_data[dyn_idx].color;
					uint light_type   = global_ubo.dyn_light_data[dyn_idx].type & 0xffff;
					uint light_style  = global_ubo.dyn_light_data[dyn_idx].type >> 16;

					if(light_type == DYNLIGHT_SPHERE)
					{
						vec3 c = light_center - position;
						float dist = length(c);
						float rdist = 1.0 / max(dist, 1e-6);
						float radius = global_ubo.dyn_light_data[dyn_idx].radius;
						float irradiance = 2.0 * (1.0 - sqrt(max(0.0, 1.0 - square(radius * rdist))));
						irradiance = min(irradiance, 2.0 * M_PI);
						light_color *= irradiance;

						if(dot(pos_on_light - position, geo_normal) > 0 && luminance(light_color) > 0)
							valid_sample = true;
					}
					else if(light_type == DYNLIGHT_SPOT)
					{
						float irradiance = restir_dynlight_spot_irradiance(dyn_idx, light_style, position, pos_on_light);
						light_color *= irradiance;

						if(dot(pos_on_light - position, geo_normal) > 0 && luminance(light_color) > 0)
							valid_sample = true;
					}
					else
					{
						valid_sample = false;
					}
				}
			}
			else
			{
				uint poly_idx = restir_get_light_index(res.lightData);

				if(poly_idx < MAX_LIGHT_POLYS)
				{
					LightPolygon light = get_light_polygon(poly_idx);

					// Sky polygon lights not supported in Milestone 1.
					if(light.color.r >= 0.0)
					{
						mat3 projected = project_triangle(light.positions, position);
						float pdfw = get_spherical_triangle_pdfw(projected);

						if(pdfw > 0.0)
						{
							vec3 light_normal = normalize(cross(
								light.positions[1] - light.positions[0],
								light.positions[2] - light.positions[0]));
							vec3 L = normalize(pos_on_light - position);
							float LdotNL = max(0.0, -dot(light_normal, L));
							float spotlight = sqrt(LdotNL);
							float inv_pdfw = 1.0 / pdfw;

							light_color = light.color * (inv_pdfw * spotlight * light.light_style_scale);

							if(dot(L, geo_normal) > 0 && luminance(abs(light_color)) > 0)
								valid_sample = true;
						}
					}
				}
			}

			if(valid_sample)
			{
				vec3 L = normalize(pos_on_light - position);

				Ray shadow_ray = get_shadow_ray(position - view_direction.xyz * 0.01, pos_on_light, 0);
				float vis = trace_shadow_ray(shadow_ray, shadow_cull_mask);

#ifdef ENABLE_SHADOW_CAUSTICS
				if(spec_enable_caustics != 0)
					light_color *= trace_caustic_ray(shadow_ray, primary_medium);
#endif

				vec3 radiance = vis * light_color * res.W;

				vec3 F = vec3(0);

				if(vis > 0 && direct_specular_weight > 0)
				{
					vec3 specular_brdf = GGX_times_NdotL(view_direction.xyz, L,
						normal, primary_roughness, primary_base_reflectivity, 0.0, primary_specular_factor, F);
					direct_specular = radiance * specular_brdf * direct_specular_weight;
				}

				float NdotL = max(0.0, dot(normal, L));
				float diffuse_brdf = NdotL / M_PI;
				direct_diffuse = radiance * diffuse_brdf * (vec3(1.0) - F);
			}
		}
	}
	else
	{
		// ---- Legacy direct lighting path (unchanged) ---- //
		get_direct_illumination(
			position, 
			normal, 
			geo_normal, 
			cluster_idx, 
			material_id, 
			shadow_cull_mask, 
			view_direction.xyz, 
			primary_albedo,
			primary_base_reflectivity,
			primary_specular_factor,
			primary_roughness, 
			primary_medium, 
			spec_enable_caustics != 0, 
			direct_specular_weight, 
			global_ubo.pt_direct_polygon_lights > 0,
			global_ubo.pt_direct_dyn_lights > 0,
			is_gradient,
			0,
			direct_diffuse,
			direct_specular);
	}

    high_freq += direct_diffuse;
    o_specular += direct_specular;
	
	bool suppress_legacy_sun = suppress_sun_for_restir_debug || (global_ubo.pt_restir_di != 0);
	if(global_ubo.pt_direct_sun_light != 0 && !suppress_legacy_sun)
	{
		vec3 direct_sun_diffuse, direct_sun_specular;
		get_sunlight(
			cluster_idx,
			material_id,
			position,
			normal,
			geo_normal,
			view_direction.xyz,
			primary_base_reflectivity,
			primary_specular_factor,
			primary_roughness,
			primary_medium,
			spec_enable_caustics != 0,
			direct_sun_diffuse,
			direct_sun_specular,
			shadow_cull_mask);

		high_freq += direct_sun_diffuse;
		o_specular += direct_sun_specular;
	}

	o_specular = demodulate_specular(primary_base_reflectivity, o_specular);

	high_freq = clamp_output(high_freq);
	o_specular = clamp_output(o_specular);
}

void
main() 
{
	ivec2 ipos = ivec2(rt_LaunchID.xy);
	if(rt_LaunchID.z != 0)
		ipos.x += global_ubo.width / 2;

	bool is_odd_checkerboard = (rt_LaunchID.z != 0) || (push_constants.gpu_index == 1);

	vec3 high_freq, specular;
	direct_lighting(ipos, is_odd_checkerboard, high_freq, specular);

	high_freq *= STORAGE_SCALE_HF;
	specular *= STORAGE_SCALE_SPEC;
	
	imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
	imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
	imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(high_freq)));
	imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(specular)));
}
