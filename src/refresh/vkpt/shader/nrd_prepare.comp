#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"

#include "projection.glsl"
#include "utils.glsl"

vec4 pack_nrd_normal_roughness(vec3 normal, float roughness)
{
	float max_abs = max(abs(normal.x), max(abs(normal.y), abs(normal.z)));
	if (max_abs > 0.0)
		normal /= max_abs;

	return vec4(normal, clamp(roughness, 0.0, 1.0));
}

float signed_distance_sign(float value)
{
	return value < 0.0 ? -1.0 : 1.0;
}

vec3 load_fast_path_diffuse(ivec2 ipos)
{
	vec3 diffuse = unpackRGBE(texelFetch(TEX_PT_COLOR_HF, ipos, 0).x) / STORAGE_SCALE_HF;
	vec3 sun_diff_bypass = unpackRGBE(texelFetch(TEX_ASVGF_ATROUS_PONG_HF, ipos, 0).x) / STORAGE_SCALE_HF;
	return max(diffuse - sun_diff_bypass, vec3(0.0));
}

vec3 load_fast_path_specular(ivec2 ipos)
{
	vec3 specular = unpackRGBE(texelFetch(TEX_PT_COLOR_SPEC, ipos, 0).x) / STORAGE_SCALE_SPEC;
	vec3 sun_spec_bypass = unpackRGBE(texelFetch(TEX_ASVGF_ATROUS_PING_HF, ipos, 0).x) / STORAGE_SCALE_SPEC;
	return max(specular - sun_spec_bypass, vec3(0.0));
}

vec2 estimate_fast_path_confidence(ivec2 ipos, float view_depth, vec3 normal, vec3 diffuse, vec3 specular, int checkerboard_flags)
{
	const ivec2 offsets[4] = {
		ivec2(-1, 0),
		ivec2( 1, 0),
		ivec2( 0,-1),
		ivec2( 0, 1),
	};

	float depth_scale = max(texelFetch(TEX_PT_MOTION, ipos, 0).w, 1e-6);
	float diff_lum_center = luminance(diffuse);
	float spec_lum_center = luminance(specular);
	float diff_metric = 0.0;
	float spec_metric = 0.0;
	float sum_w = 0.0;

	for (int i = 0; i < 4; i++)
	{
		ivec2 sample_pos = ipos + offsets[i];
		if (sample_pos.x < 0 || sample_pos.y < 0 || sample_pos.x >= global_ubo.current_gpu_slice_width || sample_pos.y >= global_ubo.height)
			continue;

		float sample_depth = texelFetch(TEX_PT_VIEW_DEPTH_A, sample_pos, 0).x;
		if (abs(sample_depth) >= (PRIMARY_RAY_T_MAX * 0.5))
			continue;

		vec3 sample_normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, sample_pos, 0).x);
		float sample_weight = exp(-abs(sample_depth - view_depth) * depth_scale);
		sample_weight *= pow(max(0.0, dot(normal, sample_normal)), 16.0);
		if (sample_weight > 0.0)
		{
			float diff_lum_sample = luminance(load_fast_path_diffuse(sample_pos));
			float spec_lum_sample = luminance(load_fast_path_specular(sample_pos));
			diff_metric += abs(diff_lum_sample - diff_lum_center) / (0.05 + max(diff_lum_sample, diff_lum_center)) * sample_weight;
			spec_metric += abs(spec_lum_sample - spec_lum_center) / (0.05 + max(spec_lum_sample, spec_lum_center)) * sample_weight;
			sum_w += sample_weight;
		}
	}

	if (sum_w > 0.0)
	{
		float inv_w = 1.0 / sum_w;
		diff_metric *= inv_w;
		spec_metric *= inv_w;
	}

	vec2 confidence = clamp(vec2(1.0) - vec2(diff_metric, spec_metric), vec2(0.05), vec2(1.0));
	if ((checkerboard_flags & CHECKERBOARD_FLAG_WEAPON) != 0)
	{
		float weapon_confidence_floor = clamp(1.0 - global_ubo.flt_grad_weapon, 0.0, 1.0);
		confidence.y = max(confidence.y, weapon_confidence_floor);
	}

	return confidence;
}

void main()
{
	ivec2 ipos = ivec2(gl_GlobalInvocationID.xy);
	if (ipos.x >= global_ubo.current_gpu_slice_width || ipos.y >= global_ubo.height)
		return;

	float view_depth = texelFetch(TEX_PT_VIEW_DEPTH_A, ipos, 0).x;
	vec3 motion = texelFetch(TEX_PT_MOTION, ipos, 0).xyz;
	uint packed_normal = texelFetch(TEX_PT_NORMAL_A, ipos, 0).x;
	vec2 metallic_roughness = texelFetch(TEX_PT_METALLIC_A, ipos, 0).rg;
	float spec_hit_dist = texelFetch(TEX_PT_SPEC_HIT_DIST_A, ipos, 0).x;
	int checkerboard_flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0).w);

	bool has_surface = abs(view_depth) < (PRIMARY_RAY_T_MAX * 0.5);
	bool is_checkerboarded_surface = bitCount(checkerboard_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1;
	bool is_secondary_surface = view_depth < 0.0 || is_checkerboarded_surface;
	bool fast_path = global_ubo.pt_fast_path != 0.0;

	vec3 normal = has_surface ? decode_normal(packed_normal) : vec3(0.0, 0.0, 1.0);
	float roughness = has_surface ? metallic_roughness.y : 1.0;

	vec3 diffuse = has_surface ? unpackRGBE(texelFetch(TEX_PT_COLOR_HF, ipos, 0).x) / STORAGE_SCALE_HF : vec3(0.0);
	vec3 specular = has_surface ? unpackRGBE(texelFetch(TEX_PT_COLOR_SPEC, ipos, 0).x) / STORAGE_SCALE_SPEC : vec3(0.0);
	vec3 sun_spec_bypass = has_surface ? unpackRGBE(texelFetch(TEX_ASVGF_ATROUS_PING_HF, ipos, 0).x) / STORAGE_SCALE_SPEC : vec3(0.0);
	vec3 sun_diff_bypass = has_surface ? unpackRGBE(texelFetch(TEX_ASVGF_ATROUS_PONG_HF, ipos, 0).x) / STORAGE_SCALE_HF : vec3(0.0);
	specular = max(specular - sun_spec_bypass, vec3(0.0));
	diffuse = max(diffuse - sun_diff_bypass, vec3(0.0));

	vec2 confidence = vec2(0.0);
	if (has_surface)
	{
		// Use ASVGF temporal gradient for NRD confidence in both fast and non-fast path.
		// gradient_reproject now runs in fast path too (main.c), so GRAD_SMPL_POS_A is
		// always fresh and GRAD_HF_SPEC_PONG is a valid temporal lighting-change detector.
		// The old fast-path spatial estimator (estimate_fast_path_confidence) measured
		// single-frame 1-spp spatial variance which is always high, clamping confidence
		// to ~0.05 and forcing NRD to discard its temporal history every frame.
		vec2 grad_pos = (vec2(ipos) + vec2(0.5)) / float(GRAD_DWN) - vec2(0.5);
		ivec2 grad_base = ivec2(floor(grad_pos));
		vec2 grad_frac = grad_pos - vec2(grad_base);

		ivec2 grad_max = (ivec2(global_ubo.current_gpu_slice_width, global_ubo.height) + GRAD_DWN - 1) / GRAD_DWN - 1;
		ivec2 g00 = clamp(grad_base,              ivec2(0), grad_max);
		ivec2 g10 = clamp(grad_base + ivec2(1,0), ivec2(0), grad_max);
		ivec2 g01 = clamp(grad_base + ivec2(0,1), ivec2(0), grad_max);
		ivec2 g11 = clamp(grad_base + ivec2(1,1), ivec2(0), grad_max);

		vec2 v00 = texelFetch(TEX_ASVGF_GRAD_HF_SPEC_PONG, g00, 0).rg;
		vec2 v10 = texelFetch(TEX_ASVGF_GRAD_HF_SPEC_PONG, g10, 0).rg;
		vec2 v01 = texelFetch(TEX_ASVGF_GRAD_HF_SPEC_PONG, g01, 0).rg;
		vec2 v11 = texelFetch(TEX_ASVGF_GRAD_HF_SPEC_PONG, g11, 0).rg;

		vec2 filtered_gradients = mix(mix(v00, v10, grad_frac.x), mix(v01, v11, grad_frac.x), grad_frac.y);
		confidence = clamp(vec2(1.0) - filtered_gradients, vec2(0.0), vec2(1.0));
	}

	float nrd_view_z = PRIMARY_RAY_T_MAX * 3.0;
	vec3 nrd_motion = vec3(0.0);
	if (has_surface)
	{
		vec2 screen_uv = (vec2(ipos) + vec2(0.5)) / vec2(global_ubo.current_gpu_slice_width, global_ubo.height);
		// view_depth is negative for reflected/refracted surfaces (by convention from reflect_refract.rgen,
		// which negates distance_curr for both reflection and refraction paths so that ASVGF filters do not
		// blur across reflection/refraction boundaries).  NRD expects viewZ to be the un-modified camera-space
		// Z coordinate of the visible surface, which is always negative for a surface in front of the camera
		// (camera looks down -Z in view space).  Multiplying by view_z_sign would flip reflected/refracted
		// pixels to positive viewZ, making them appear to be behind the camera.  NRD then fires disocclusion
		// on every frame at every glass/opaque boundary (depth difference = ~2*D vs threshold ~0.01*D),
		// preventing temporal accumulation for glass pixels and producing the per-pixel checkerboard artifact.
		// Fix: use view_pos.z directly — it is always negative for a visible surface regardless of the
		// Q2RTX depth-sign convention stored in PT_VIEW_DEPTH_A.
		float signed_depth_prev = view_depth + motion.z;

		vec3 view_pos = projection_screen_to_view(screen_uv, abs(view_depth), false);
		vec3 view_pos_prev = projection_screen_to_view(screen_uv + motion.xy, abs(signed_depth_prev), true);

		nrd_view_z = view_pos.z;
		nrd_motion = vec3(motion.xy, view_pos_prev.z - nrd_view_z);
	}

	float disocclusion_mix = 0.0;
	if (has_surface && is_secondary_surface)
	{
		disocclusion_mix = 0.5;
		if (is_checkerboarded_surface)
			disocclusion_mix = 0.75;
	}

	imageStore(IMG_NRD_NORMAL_ROUGHNESS, ipos, pack_nrd_normal_roughness(normal, roughness));
	imageStore(IMG_NRD_DIFF_RADIANCE_HITDIST, ipos, vec4(max(diffuse, vec3(0.0)), 0.0));
	float nrd_spec_hit_dist = spec_hit_dist > 0.0 ? spec_hit_dist : abs(nrd_view_z);
	imageStore(IMG_NRD_SPEC_RADIANCE_HITDIST, ipos, vec4(max(specular, vec3(0.0)), has_surface ? nrd_spec_hit_dist : 0.0));
	imageStore(IMG_NRD_DIFF_CONFIDENCE, ipos, vec4(confidence.x));
	imageStore(IMG_NRD_SPEC_CONFIDENCE, ipos, vec4(confidence.y));
	imageStore(IMG_NRD_DISOCCLUSION_MIX, ipos, vec4(disocclusion_mix));
	imageStore(IMG_NRD_VIEWZ, ipos, vec4(nrd_view_z));
	imageStore(IMG_NRD_MV, ipos, vec4(nrd_motion, 0.0));
}
